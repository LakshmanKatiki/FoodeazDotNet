@page "/about"
@model Foodeaz.Web.Pages.AboutModel
@{ ViewData["Title"] = "About"; }








    <!-- main -->
    <main class="subpage">
        
        
        <!-- sub page header -->
        <section class="subpage-header about-header">
            <div class="container">
                 <div class="row">
                    
                </div>
            </div>
        </section>
        <!--/ sub page heder -->

         <!-- sub page body -->
         <section class="subpage-body">
            <div class="custom-container">
                <div class="row">
                    <div class="col-md-6 align-self-center aos-item">
                        <h5>About us</h5>
                        <h2 class="h2 ">Welcome to Foodeaz</h2>
                        <p>At Foodeaz, we believe food is more than just a meal &mdash; 
                            it&rsquo;s a feeling of comfort, tradition, and health.</p>
                        <ul>
                          <li>No preservatives</li>
                          <li>100% natural ingredients</li>
                          <li>Fermented for the perfect flavor &amp; texture</li>
                        </ul>
                        <h2 class="h3">Our services</h2>
                        <p>Our mission is simple: to make your breakfast both delicious and effortless.</p>

                        <h3 class="h3">Our Products</h3>
                        <p>
                          <ul>
                            <li>
                              <h4>Foodeaz Idli Batter</h4>
                              <p>Fluffy, light, and melt-in-your-mouth idlis made in minutes.</p>
                            </li>
                            <li>
                              <h4>Foodeaz Dosa Batter</h4>
                              <p>Golden, crisp, and lacy dosas that taste just like your favorite tiffin center.</p>
                            </li>
                            <li>
                              <h4>Foodeaz Multi-Grain Batter <span style="font-weight:normal;">(optional)</span></h4>
                              <p>A wholesome twist with the goodness of ragi, millet, and grains for health-conscious food lovers.</p>
                            </li>
                          </ul>
                        </p> 
                    </div>
                    <div class="col-md-6">
                        <img src="/img/idly.jpg" alt="" class="img-fluid">
                    </div>
                </div>

                </div>
            </div>
         </section>
        <!--/ sub page body -->

    </main>
    <!--/ main -->

