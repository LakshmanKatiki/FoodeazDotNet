@page "/contact"
@model Foodeaz.Web.Pages.ContactModel
@{ ViewData["Title"] = "Contact us"; }
<section class="subpage-header contact-header py-5"><div class="container"><h1>Contact us</h1><p>We would love to hear from you.</p></div></section><section class="container py-5"><div class="row"><div class="col-lg-8"><h2>Send us a message</h2>@if (!string.IsNullOrWhiteSpace(Model.StatusMessage)) { <div class="alert @(Model.Success ? "alert-success" : "alert-danger")">@Model.StatusMessage</div> }<form method="post"><div class="mb-3"><label asp-for="Input.Name" class="form-label">Name</label><input asp-for="Input.Name" class="form-control" required maxlength="100" /></div><div class="mb-3"><label asp-for="Input.Email" class="form-label">Email</label><input asp-for="Input.Email" type="email" class="form-control" required maxlength="254" /></div><div class="mb-3"><label asp-for="Input.Phone" class="form-label">Phone</label><input asp-for="Input.Phone" class="form-control" maxlength="30" /></div><div class="mb-3"><label asp-for="Input.Subject" class="form-label">Subject</label><input asp-for="Input.Subject" class="form-control" required maxlength="150" /></div><div class="mb-3"><label asp-for="Input.Message" class="form-label">Message</label><textarea asp-for="Input.Message" class="form-control" rows="5" required maxlength="5000"></textarea></div><button class="btn btn-primary" type="submit">Send message</button></form></div></div></section>
