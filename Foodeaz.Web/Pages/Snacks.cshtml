@page "/snacks"
@model Foodeaz.Web.Pages.SnacksModel
@{ ViewData["Title"] = "Snacks"; }








    <!-- main -->
    <main class="subpage">
        
        
        <!-- sub page header -->
        <section class="subpage-header snacks-header">
            <div class="container">
                 <div class="row">
                    <div class="col-md-6">
                        <h5 class="h6 text-uppercase position-relative">Product</h5>
                        <h1 class="h1 fbold">Snacks </h1>                       
                    </div>
                </div>
            </div>
        </section>
        <!--/ sub page heder -->

         <!-- sub page body -->
         <section class="subpage-body">
                <div class="custom-container">
                    <div class="row">
                        <div class="col-lg-4">
                            <div class="product-col text-center">
                                <img src="/img/products/snacks/CCC-Special-Warrior-Biscuits.jpg">
                                <h5 class="h5 pt-4">CCC Special Warrior Biscuits </h5>
                            </div>
                        </div>
                        <div class="col-lg-4">
                            <div class="product-col text-center">
                                <img src="/img/products/snacks/Veg-Puff.jpg">
                                <h5 class="h5 pt-4">Veg Puff </h5>
                            </div>
                        </div>    
                        <div class="col-lg-4">
                            <div class="product-col text-center">
                                <img src="/img/products/snacks/Paneer-Puff.jpg">
                                <h5 class="h5 pt-4">Paneer Puff</h5>
                            </div>
                        </div>                                                                            
                    </div>
                </div>
         </section>
        <!--/ sub page body -->

    </main>
    <!--/ main -->

    <!-- footer -->
    
    <!--/ footer -->
    


