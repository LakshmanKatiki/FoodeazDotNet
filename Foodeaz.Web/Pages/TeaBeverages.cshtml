@page "/tea-beverages"
@model Foodeaz.Web.Pages.TeaBeveragesModel
@{ ViewData["Title"] = "Tea Beverages"; }








    <!-- main -->
    <main class="subpage">
        
        
        <!-- sub page header -->
        <section class="subpage-header tea-beverages-header">
            <div class="container">
                 <div class="row">
                    <div class="col-md-6">
                        <h5 class="h6 text-uppercase position-relative">Product</h5>
                        <h1 class="h1 fbold">Tea Beverages</h1>                       
                    </div>
                </div>
            </div>
        </section>
        <!--/ sub page heder -->

         <!-- sub page body -->
         <section class="subpage-body">
                <div class="custom-container">
                    <div class="row">
                        <div class="col-lg-4">
                            <div class="product-col text-center">
                                <img src="/img/products/tea-beverages/CCC-special-Bombay-Cut-Tea.jpg">
                                <h5 class="h5 pt-4">CCC special Bombay Cut Tea</h5>
                            </div>
                        </div>
                        <div class="col-lg-4">
                            <div class="product-col text-center">
                                <img src="/img/products/tea-beverages/Blue-Ocean-Tea.jpg">
                                <h5 class="h5 pt-4">Blue Ocean Tea </h5>
                            </div>
                        </div>
                        <div class="col-lg-4">
                            <div class="product-col text-center">
                                <img src="/img/products/tea-beverages/Masala-Tea.jpg">
                                <h5 class="h5 pt-4">Masala Tea</h5>
                            </div>
                        </div>
                        <div class="col-lg-4">
                            <div class="product-col text-center">
                                <img src="/img/products/tea-beverages/Guava-Tea.jpg">
                                <h5 class="h5 pt-4">Guava Tea</h5>
                            </div>
                        </div>                                            
                    </div>
                </div>
         </section>
        <!--/ sub page body -->

    </main>
    <!--/ main -->

    <!-- footer -->
    
    <!--/ footer -->
    


