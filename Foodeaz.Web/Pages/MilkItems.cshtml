@page "/milk-items"
@model Foodeaz.Web.Pages.MilkItemsModel
@{ ViewData["Title"] = "Milk Items"; }








    <!-- main -->
    <main class="subpage">
        
        
        <!-- sub page header -->
        <section class="subpage-header milk-items-header">
            <div class="container">
                 <div class="row">
                    <div class="col-md-6">
                        <h5 class="h6 text-uppercase position-relative">Product</h5>
                        <h1 class="h1 fbold">Milk Items</h1>                       
                    </div>
                </div>
            </div>
        </section>
        <!--/ sub page heder -->

         <!-- sub page body -->
         <section class="subpage-body">
                <div class="custom-container">
                    <div class="row">
                        <div class="col-lg-4">
                            <div class="product-col text-center">
                                <img src="/img/products/Milk-Items/Special-Miriyala-Haalu.jpg">
                                <h5 class="h5 pt-4"> Chikmagalur Special Miriyala Haalu ( Special Pepper Milk)</h5>
                            </div>
                        </div>
                        <div class="col-lg-4">
                            <div class="product-col text-center">
                                <img src="/img/products/Milk-Items/Elachi-Milk.jpg">
                                <h5 class="h5 pt-4">Elachi Milk</h5>
                            </div>
                        </div>
                        <div class="col-lg-4">
                            <div class="product-col text-center">
                                <img src="/img/products/Milk-Items/Boost.jpg">
                                <h5 class="h5 pt-4">Boost</h5>
                            </div>
                        </div>
                        <div class="col-lg-4">
                            <div class="product-col text-center">
                                <img src="/img/products/Milk-Items/horlicks.jpg">
                                <h5 class="h5 pt-4">Horlicks</h5>
                            </div>
                        </div>
                        <div class="col-lg-4">
                            <div class="product-col text-center">
                                <img src="/img/products/Milk-Items/Hot-Badam.jpg">
                                <h5 class="h5 pt-4">Hot Badam</h5>
                            </div>
                        </div>                        
                    </div>
                </div>
         </section>
        <!--/ sub page body -->

    </main>
    <!--/ main -->

    <!-- footer -->
    
    <!--/ footer -->
    


