@page "/cold-beverages"
@model Foodeaz.Web.Pages.ColdBeveragesModel
@{ ViewData["Title"] = "Cold Beverages"; }








    <!-- main -->
    <main class="subpage">
        
        
        <!-- sub page header -->
        <section class="subpage-header Cold-Beverages-header">
            <div class="container">
                 <div class="row">
                    <div class="col-md-6">
                        <h5 class="h6 text-uppercase position-relative">Product</h5>
                        <h1 class="h1 fbold">Cold Beverages </h1>                       
                    </div>
                </div>
            </div>
        </section>
        <!--/ sub page heder -->

         <!-- sub page body -->
         <section class="subpage-body">
                <div class="custom-container">
                    <div class="row">
                        <div class="col-lg-4">
                            <div class="product-col text-center">
                                <img src="/img/products/cold-beverages/CCC-Cold-Coffee.jpg">
                                <h5 class="h5 pt-4">CCC Cold Coffee</h5>
                            </div>
                        </div>
                        <div class="col-lg-4">
                            <div class="product-col text-center">
                                <img src="/img/products/cold-beverages/CCC-Chocolate-Coffee.jpg">
                                <h5 class="h5 pt-4">CCC Chocolate Coffee</h5>
                            </div>
                        </div>    
                        <div class="col-lg-4">
                            <div class="product-col text-center">
                                <img src="/img/products/cold-beverages/Blue-Ocean-Mojito.jpg">
                                <h5 class="h5 pt-4">Blue Ocean Mojito</h5>
                            </div>
                        </div>
                        <div class="col-lg-4">
                            <div class="product-col text-center">
                                <img src="/img/products/cold-beverages/Passion-Fruit.jpg">
                                <h5 class="h5 pt-4">Passion Fruit</h5>
                            </div>
                        </div>
                        <div class="col-lg-4">
                            <div class="product-col text-center">
                                <img src="/img/products/cold-beverages/Classic-Mojitos.jpg">
                                <h5 class="h5 pt-4">Classic Mojitos</h5>
                            </div>
                        </div>
                        <div class="col-lg-4">
                            <div class="product-col text-center">
                                <img src="/img/products/cold-beverages/Peach-Garden.jpg">
                                <h5 class="h5 pt-4">Peach Garden</h5>
                            </div>
                        </div>                                                            
                    </div>
                </div>
