@page "/traditional-coffee"
@model Foodeaz.Web.Pages.TraditionalCoffeeModel
@{ ViewData["Title"] = "Traditional Coffee"; }








    <!-- main -->
    <main class="subpage">
        
        
        <!-- sub page header -->
        <section class="subpage-header traditional-coffee-header">
            <div class="container">
                 <div class="row">
                    <div class="col-md-6">
                        <h5 class="h6 text-uppercase position-relative">Product</h5>
                        <h1 class="h1 fbold">Traditional Coffees</h1>                       
                    </div>
                </div>
            </div>
        </section>
        <!--/ sub page heder -->

         <!-- sub page body -->
         <section class="subpage-body">
                <div class="custom-container">
                    <div class="row">
                        <div class="col-lg-4">
                            <div class="product-col text-center">
                                <img src="/img/products/coffees/Chikmagalur-Filter-Coffee.jpg">
                                <h5 class="h5 pt-4">Chikmagalur Filter Coffee</h5>
                            </div>
                        </div>
                        <div class="col-lg-4">
                            <div class="product-col text-center">
                                <img src="/img/products/coffees/Divyaamrutham-Special-Coorg-Coffee.jpg">
                                <h5 class="h5 pt-4">Divyaamrutham Special Coorg Coffee</h5>
                            </div>
                        </div>
                        <div class="col-lg-4">
                            <div class="product-col text-center">
                                <img src="/img/products/coffees/Sukku-Coffee.jpg">
                                <h5 class="h5 pt-4">Sukku Coffee</h5>
                            </div>
                        </div>
                        <div class="col-lg-4">
                            <div class="product-col text-center">
                                <img src="/img/products/coffees/Black-Coffee.jpg">
                                <h5 class="h5 pt-4">Black Coffee</h5>
                            </div>
                        </div>
                        <div class="col-lg-4">
                            <div class="product-col text-center">
                                <img src="/img/products/coffees/Divyaamrutham-Special-Green-Coffee.jpg">
                                <h5 class="h5 pt-4">Divyaamrutham Special Green Coffee</h5>
                            </div>
                        </div>
                        <div class="col-lg-4">
                            <div class="product-col text-center">
                                <img src="/img/products/coffees/Masala-Coffee.jpg">
                                <h5 class="h5 pt-4">Masala Coffee</h5>
                            </div>
                        </div>
                    </div>
                </div>
         </section>
        <!--/ sub page body -->

    </main>
    <!--/ main -->

    <!-- footer -->
    
    <!--/ footer -->
    


