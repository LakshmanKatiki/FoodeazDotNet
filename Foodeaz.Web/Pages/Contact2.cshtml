@page "/contact2"
@model Foodeaz.Web.Pages.Contact2Model
@{ ViewData["Title"] = "Contact2"; }








    <!-- main -->
    <main class="subpage">
        

        <!-- sub page header -->
        <section class="subpage-header contact-header">
            <div class="container">
                 <div class="row">
                    <div class="col-md-6">
                        <h5 class="h6 text-uppercase position-relative">Touch with us</h5>
                        <h1 class="h1 fbold">Contact</h1>
                    </div>
                </div>
            </div>
        </section>
        <!--/ sub page heder -->

         <!-- sub page body -->
         <section class="subpage-body">
            <div class="custom-container">
                <div class="row">
                    <div class="row justify-content-center py-3 py-md-5">
                        <div class="col-md-6 text-center">
                            <h6 class="fbold">GET IN TOUCH</h6>
                            <h2 class="h1 fbold py-2">We love to hear from you</h2>
                            <p>call us to book a meetup or send us emails to request for service consultation.</p>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-lg-4">
                            <div class="contactCol d-flex border-bottom mb-3">
                                <span class="icon-location-arrow icomoon align-self-center"></span>
                                <article class="ps-5">
                                    <h5 class="fbold pb-2">Chik Magalur Coffee Cafe</h5>
                                    <p>B42, 4th Floor, Rd Number 3, above Vision Express, MLA Colony, Jubilee Hills, Hyderabad, Telangana 500033</p>
                                </article>
                            </div>
                            <div class="contactCol d-flex border-bottom mb-3">
                                <span class="icon-phone icomoon align-self-center"></span>
                                <article class="ps-5">
                                    <h5 class="fbold pb-2">Calling Support</h5>
                                    <p>+91 7483485901</p>
                                </article>
                            </div>
                            <div class="contactCol d-flex">
                                <span class="icon-paper-plane icomoon align-self-center"></span>
                                <article class="ps-5">
                                    <h5 class="fbold pb-2">Email</h5>
                                    <p><a href="mailto:support@chikmagalurcoffeecafe.com">support@chikmagalurcoffeecafe.com</a></p>
                                </article>
                            </div>
                        </div>
                         <!-- form -->
                         <div class="col-lg-8">
                         
<div class="alert alert-success alert-dismissible fade show" role="alert">
  Mail Sent Successfully. Thank you , we will contact you shortly.
  <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>

                            <form class="ps-3 pb-5 contactForm" id="contact_form" action="" method="post">
                                <div class="row ">
                                    <div class="col-md-6">
                                        <div class="mb-3 form-group">
                                            <label for="name" class="form-label">Name*</label>
                                            <input type="text" class="form-control" id="name" placeholder="Write your name" name="name">
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="mb-3 form-group">
                                            <label for="mail" class="form-label">Your Email*</label>
                                            <input type="email" class="form-control" id="mail" placeholder="name@youremail.com" name="email">
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="mb-3 form-group">
                                            <label for="phone" class="form-label">Phone Number*</label>
                                            <input type="text" class="form-control" id="phone" placeholder="Write Valid Number" name="phone">
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="mb-3 form-group">
                                            <label for="sub" class="form-label">Subject</label>
                                            <input type="text" class="form-control" id="sub" placeholder="Write Subject" name="sub">
                                        </div>
                                    </div>
                                    <div class="col-md-12">
                                        <div class="mb-3 form-group">
                                            <label for="msg" class="form-label">Message</label>
                                            <textarea style="height:150px;" class="form-control" id="msg" name="msg" placeholder="Writet Message"></textarea>
                                        </div>
                                    </div>
                                    <div class="col-md-12">
                                        <div class="form-group">
                                            <!-- google recapthca box -->
                                            <div class="g-recaptcha" data-sitekey="">

                                            </div>
                                            <!--/ google recaptcha box -->
                                        </div>
                                    </div>
                                    <div class="col-md-12">
                                        <input type="submit" value="Submit" class="link d-block w-100 text-center" name="submitContact">
                                        <!-- <button class="btn w-100 text-uppercase link w-100 mt-3" name="submitContact">Submit</button>  -->
                                    </div>
                                </div>
                            </form>

                        </div>
                        <!--/ form -->
                    </div>

                    <div class="row">
                        <div class="col-lg-12">
                        <iframe src="https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d15227.512260061943!2d78.4127368!3d17.4176384!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3bcb97d3d6b1f06b%3A0x954d26372ac69dec!2sGopinadh%20%26%20Associates%2C%20Chartered%20Accountants.!5e0!3m2!1sen!2sin!4v1678679143239!5m2!1sen!2sin" width="100%" height="450" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
                        </div>
                    </div>

                </div>
            </div>
         </section>
        <!--/ sub page body -->

    </main>
    <!--/ main -->

    <!-- footer -->
    
    <!--/ footer -->
    






